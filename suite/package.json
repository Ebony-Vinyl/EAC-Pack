{
  "name": "eac-plugin-suite",
  "version": "0.3.0-beta.0",
  "private": true,
  "type": "module",
  "description": "EAC/AIO 插件整合包 — one-click install and update for the full EAC and AIO plugin suites on DeepSeek Harness desktop.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./catalog/*.json": "./catalog/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "catalog",
    "icon.svg",
    "LICENSE",
    "README.md",
    "resources.mjs",
    "assets/bootstrap.json",
    "scripts/verify-package.mjs",
    "asset-package.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "eac",
    "aio",
    "eac-plugin-suite"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "test": "node --test",
    "dev": "node dev/serve.mjs",
    "dev:deps": "node dev/build-deps.mjs",
    "prepack": "node scripts/verify-package.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "eac-plugin-suite-assets": "0.3.0-beta.0"
  }
}
