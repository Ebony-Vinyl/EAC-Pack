 /** Settings namespace for this plugin (written to DSH settings.yaml). */
 export const NS = 'computer-user';
 
+/* `volatile()` marks a field as editable without remounting the plugin.
+ *
+ * DSH 0.1.7-rc.2 replaced the namespace-registration settings model with
+ * Config-schema-derived forms: `SettingsForms.describe()` projects the schema
+ * exported as `Config` by the plugin entry through `volatileForm()`, which
+ * keeps ONLY fields whose nearest volatile ancestor is marked. An unmarked
+ * schema projects to `undefined`, so no form is produced, `configForms.get()`
+ * answers `status: 'unavailable'` and the settings card stays blank. Upstream
+ * 0.3.7 declares this schema but never marks a field — one reason its card
+ * cannot work on a 0.2.x kernel even once `Config` is exported (see the
+ * sibling `src/index.js` patch).
+ *
+ * Guarded so a schemastery build without `volatile()` still yields the plain
+ * schema instead of throwing at import time. */
+const live = (leaf) => (typeof leaf?.volatile === 'function' ? leaf.volatile() : leaf);
+
 /** Runtime settings schema (schemastery). Top fields are the "just-opened" card; the rest go to Advanced. */
 export const Config = z.object({
