-    .number()
-    .default(1)
-    .description('截图默认缩放 0.1..1（1=原分辨率整屏）'),
-  typing_interval_ms: z
-    .number()
-    .default(0)
-    .description('逐字输入间隔（毫秒），越大越稳但越慢'),
